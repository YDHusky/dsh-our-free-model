ARG RUNTIME_BASE_IMAGE
FROM ${RUNTIME_BASE_IMAGE}

USER root

ENV NODE_ENV=production \
    OFM_DATA_DIR=/data \
    OFM_PORT=8080 \
    OUR_FREE_MODEL_BUN=/usr/local/bin/bun

WORKDIR /app

# The pinned bootstrap image already contains Node and Bun. Remove its old
# application tree so this build contains only the current staged runtime.
RUN find /app -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
COPY --chown=node:node . .

RUN mkdir -p /data \
    && chown node:node /data

USER node

VOLUME ["/data"]
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=8s --start-period=30s --retries=3 \
  CMD ["node", "packages/proxy/healthcheck.mjs"]

CMD ["node", "packages/proxy/cli.mjs"]
