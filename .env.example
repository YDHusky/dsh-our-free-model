# Generate a value with: openssl rand -hex 32
OFM_API_KEY=replace-with-a-long-random-secret

# Host port published by Docker Compose.
OFM_PUBLIC_PORT=8080

# Published image tag used by Docker Compose.
OFM_IMAGE_TAG=latest

# Set to true only when startup should skip catalogue refresh.
OFM_NO_REFRESH=false

# Ordered candidates behind the public `free-model` auto-router. Set to off to
# disable that virtual model id.
OFM_FREE_MODEL_CANDIDATES=deepseek-v4.1-flash-free,kilo-auto/free,openrouter/free,mimo-v2.6-flash-free,nvidia/nemotron-3.5-lightning:free
